+# PATCHED (patch-package, 2026-09-01) ‚Äî the debug build failed to link with:
+#   ld.lld: error: undefined symbol: operator new(unsigned long, std::align_val_t)
+#   ld.lld: error: undefined symbol: __gxx_personality_v0
+#   ld.lld: error: undefined symbol: std::__throw_bad_array_new_length
+#
+# All three are libc++ symbols, i.e. the C++ standard library was never linked.
+# CAUSE: this target mixes C and C++ sources ‚Äî kiss_fft.c / kiss_fftr.c are C ‚Äî
+# and CMake infers a target's LINKER_LANGUAGE from that mix. It resolved to C, so
+# the link ran through the C driver, which does not pull in libc++. The
+# `-DANDROID_STL=c++_shared` in the library's build.gradle sets which STL to use;
+# it cannot help if the C++ linker is never invoked.
+#
+# FIX: state the linker language explicitly, and link the STL by name so the
+# dependency is not implicit.
+set_target_properties(audio-studio-cpp PROPERTIES LINKER_LANGUAGE CXX)
+
 target_link_libraries(audio-studio-cpp
     android
     log
+    c++_shared
 )
 
