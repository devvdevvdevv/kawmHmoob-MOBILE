{
  "expo": {
    "name": "Kawm Hmoob",
    "slug": "kawm-hmoob",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "kawmhmoob",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kawmhmoob.app"
    },
    "android": {
      "package": "com.kawmhmoob.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
