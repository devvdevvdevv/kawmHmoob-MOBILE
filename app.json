{
  "expo": {
    "name": "Kawm Hmoob",
    "slug": "kawm-hmoob",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "kawmhmoob",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kawmhmoob.app"
    },
    "android": {
      "package": "com.kawmhmoob.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Kawm Hmoob uses your mic to score your pronunciation."
        }
      ],
      "expo-asset",
      "@siteed/audio-studio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ca4171e-b347-43e1-bf3e-4ab143c877a8"
      }
    },
    "owner": "veddveddvedd"
  }
}
